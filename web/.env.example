# ZedPrep — environment variables
# Copy this file to .env.local and fill in real values
# .env.local is git-ignored

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ZedPrep

# ---- Database (Supabase) — Step 2 ----
# Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only needed for admin/server-side operations. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- File storage (Cloudflare R2) — Step 2 ----
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=zedprep-uploads

# ---- AI — Step 4 ----
# Provider priority: MiniMax (if MINIMAX_API_KEY set) → OpenAI (if OPENAI_API_KEY set) → none.
# Both expose OpenAI-compatible APIs, so the same client code works.

# MiniMax (recommended — same company that makes MiniMax Code)
# Get one at https://api.minimax.chat (or via the MiniMax dashboard)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
# Embedding model: 'embo-01' is MiniMax's default. Override per provider.
EMBEDDING_MODEL=embo-01

# OpenAI (alternative — used if MINIMAX_API_KEY is not set)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# If using OpenAI, override EMBEDDING_MODEL with: text-embedding-3-small

# Anthropic / Claude is reserved for essay marking (Tier 3, Phase 2)
ANTHROPIC_API_KEY=

# ---- Payments — Step 6 ----
# MTN_MOMO_API_USER_ID=
# MTN_MOMO_API_KEY=
# MTN_MOMO_SUBSCRIPTION_KEY=
# MTN_MOMO_ENVIRONMENT=sandbox
# AIRTEL_MONEY_CLIENT_ID=
# AIRTEL_MONEY_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Notifications — Step 7 ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# AFRICAS_TALKING_API_KEY=
# AFRICAS_TALKING_USERNAME=
# RESEND_API_KEY=

# ---- Analytics — Step 1 (optional) ----
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# SENTRY_DSN=
